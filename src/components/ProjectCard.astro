---
import { render } from 'astro:content';
import PromoScreen from './PromoScreen.astro';
import type { Project } from '../lib/projects';
import { getDictionary, toLocale } from '../i18n';

interface Props {
  project: Project;
  // Which side the clip sits on for wide screens; the filter script updates it.
  side: 'start' | 'end';
}

const { project, side } = Astro.props;
const { data } = project;
const t = getDictionary(toLocale(Astro.currentLocale)).projects;
const { Content } = await render(project.entry);
---

<article class="project" data-category={data.category} data-side={side} data-reveal>
  <div class="media">
    <PromoScreen
      title={data.title}
      status={data.status}
      promo={project.promo}
      promoEnabled={data.promo}
    />
  </div>

  <div class="body">
    <p class="meta">
      <span class="category">{t.categories[data.category]}</span>
      <span class={`status status-${data.status}`}>{t.status[data.status]}</span>
      <span class="year">{data.year}</span>
    </p>

    <h3 class="title">{data.title}</h3>
    <p class="tagline">{data.tagline}</p>

    <div class="description">
      <Content />
    </div>

    <h4 class="visually-hidden">{t.highlightsLabel}</h4>
    <ul class="pixel-bullets highlights">
      {data.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="stack">
      <span class="stack-label">{t.stackLabel}</span>
      <ul class="chips">
        {data.stack.map((tech) => (
          <li class="chip">{tech}</li>
        ))}
      </ul>
    </div>

    {data.links.length > 0 && (
      <div class="links">
        {data.links.map((link) => (
          <a
            class={`link link-${link.kind}`}
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.links[link.kind]}
            <span class="arrow" aria-hidden="true" />
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* Clip on one side, notes on the other; rows alternate sides on wide screens. */
  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(36px, 6vw, 72px);
    border-top: 1px solid var(--color-rule);
  }

  .project[data-side='end'] .media {
    order: 2;
  }

  .project[hidden] {
    display: none;
  }

  .media {
    min-width: 0;
    max-width: 480px;
    width: 100%;
    justify-self: center;
  }

  .body {
    min-width: 0;
    display: grid;
    gap: 16px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .category {
    color: var(--color-accent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--color-led-work);
  }

  .status-live::before {
    background: var(--color-led-live);
  }

  .status-inProgress::before {
    background: var(--color-led-wip);
  }

  .title {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 800;
    text-wrap: balance;
  }

  .tagline {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .description {
    max-width: 62ch;
  }

  .description :global(p) {
    margin: 0;
  }

  .highlights {
    max-width: 62ch;
    font-size: 0.98rem;
  }

  .stack {
    display: grid;
    gap: 8px;
  }

  .stack-label {
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    padding-top: 4px;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent);
  }

  .link-play,
  .link-live {
    color: var(--color-accent);
  }

  .arrow {
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .link:hover .arrow {
    transform: translateX(3px) rotate(45deg);
  }

  @media (max-width: 820px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }

    .project[data-side='end'] .media {
      order: 0;
    }
  }
</style>
