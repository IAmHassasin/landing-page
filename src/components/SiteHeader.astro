---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SECTION_IDS } from '../config/site';
import { getDictionary, toLocale } from '../i18n';

const t = getDictionary(toLocale(Astro.currentLocale));
const navItems = [
  { id: SECTION_IDS.projects, label: t.nav.projects },
  { id: SECTION_IDS.skills, label: t.nav.skills },
  { id: SECTION_IDS.journey, label: t.nav.journey },
  { id: SECTION_IDS.awards, label: t.nav.awards },
  { id: SECTION_IDS.contact, label: t.nav.contact },
];
---

<header class="site-header">
  <div class="bar">
    <a class="prompt" href="#main" aria-hidden="true" tabindex="-1">
      <span class="caret">&gt;</span>
      {t.hero.prompt}
      <span class="cursor">_</span>
    </a>
    <nav class="nav" aria-label={t.nav.label}>
      {navItems.map((item) => (
        <a href={`#${item.id}`}>{item.label}</a>
      ))}
    </nav>
    <div class="controls">
      <LanguageSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  :global(html[data-scrolled]) .site-header {
    border-bottom-color: var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 12px var(--gutter);
  }

  .prompt {
    display: inline-flex;
    align-items: baseline;
    color: var(--color-ink);
    font-family: var(--font-pixel);
    font-size: 1.5rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .caret {
    color: var(--color-accent);
  }

  .cursor {
    animation: blink 1s steps(1) infinite;
  }

  .nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .nav a {
    position: relative;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav a:hover {
    color: var(--color-ink);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .controls {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .nav + .controls {
    margin-left: 0;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .nav + .controls {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
