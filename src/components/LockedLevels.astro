---
import { getDictionary, toLocale } from '../i18n';

const t = getDictionary(toLocale(Astro.currentLocale)).locked;
---

<section class="section" aria-labelledby="locked-title">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="locked-title" class="section-title">
      {t.title}
    </h2>
    <p class="section-intro">{t.intro}</p>
  </header>

  <ul class="levels">
    {t.items.map((item) => (
      <li class="level" data-reveal>
        <span class="lock" aria-hidden="true" />
        <span class="code" aria-hidden="true">
          {t.code}
        </span>
        <span class="teaser">{item}</span>
      </li>
    ))}
    <li class="level level-more" data-reveal>
      <span class="loading" aria-hidden="true"></span>
      <span class="teaser">{t.more}</span>
    </li>
  </ul>
</section>

<style>
  .levels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level {
    position: relative;
    display: grid;
    align-content: end;
    gap: 6px;
    min-height: 180px;
    padding: 18px;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-m);
    background: repeating-linear-gradient(
      -45deg,
      var(--color-surface) 0 10px,
      var(--color-bg) 10px 20px
    );
  }

  .code {
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 1.25rem;
  }

  .teaser {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    filter: blur(0.6px);
    transition: filter var(--duration-fast) var(--ease-out);
  }

  .level:hover .teaser {
    filter: none;
  }

  /* Pixel padlock: shackle via border, body via the pseudo element. */
  .lock {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 16px;
    height: 12px;
    border: 4px solid var(--color-muted);
    border-bottom: 0;
  }

  .lock::after {
    content: '';
    position: absolute;
    top: 8px;
    left: -8px;
    width: 24px;
    height: 16px;
    background: var(--color-muted);
  }

  .level:hover .lock {
    animation: shake 400ms steps(4);
  }

  .level-more {
    border-style: dashed;
    background: transparent;
  }

  .level-more .teaser {
    filter: none;
    color: var(--color-muted);
  }

  .loading {
    width: 100%;
    height: 8px;
    background: linear-gradient(90deg, var(--color-accent) 0 30%, var(--color-rule) 0);
    background-size: 200% 100%;
    animation: load 2.4s steps(10) infinite;
  }

  @keyframes shake {
    25% {
      transform: translateX(-2px);
    }
    75% {
      transform: translateX(2px);
    }
  }

  @keyframes load {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading,
    .level:hover .lock {
      animation: none;
    }
  }
</style>
